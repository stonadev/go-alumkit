{
  "name": "my-alumni-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./resources/css/app.css -o ./public/app.css",
    "build:js": "npx esbuild ./resources/js/app.js --bundle --outfile=./public/app.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "npx @tailwindcss/cli -i ./resources/css/app.css -o ./public/app.css --watch",
    "watch:js": "npx esbuild ./resources/js/app.js --bundle --outfile=./public/app.js --watch",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:js\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0"
  }
}
