# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=alumkit
DB_PASSWORD=password
DB_NAME=alumkit
DB_SSLMODE=disable

# App (required)
PORT=8080
SESSION_KEY=your-secret-session-key-32-chars-min
APP_URL=http://localhost:8080

# Features (optional)
FEATURE_POSTS=true
FEATURE_COMMITTEE=true

# SMTP (optional)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=AlumKit
